# ─── Credenciales requeridas ───────────────────────────────────────────────

# API Key de Google Gemini (gratuita en https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tu número de WhatsApp en formato internacional SIN el signo +
# Ejemplos: México → 521234567890  |  USA → 12125551234  |  España → 34612345678
WHATSAPP_PHONE=

# ─── Opcionales ────────────────────────────────────────────────────────────

# Puerto del servidor web (por defecto: 3000)
PORT=3000
